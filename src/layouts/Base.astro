---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}: {site.name}</title>
    <meta name="description" content={description} />

    {/*
      PRE-LAUNCH ONLY. The demo carries placeholder contact details and PENDING
      registration numbers, so it must not be indexed under the Career Plus name.
      A robots.txt does not help here: on a GitHub project page crawlers only read
      sam-yak.github.io/robots.txt, which we do not control. This tag does the work.
      DELETE THIS BLOCK when the real content and the real domain go live.
    */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <nav class="actionbar" aria-label="Quick contact">
      <a href={site.contact.phoneHref}>Call</a>
      <a href={site.contact.whatsappHref}>WhatsApp</a>
      <a href="#enquire">Enquire</a>
    </nav>
  </body>
</html>
