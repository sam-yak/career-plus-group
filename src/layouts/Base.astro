---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { site } from '../data/site';

interface Props { title?: string; description: string; }
const { title, description } = Astro.props;

/*
 * Build the tab title as ONE string in the frontmatter.
 *
 * Writing the two parts inline in the title element looked correct and was
 * not: Astro kept
 * the first expression and silently dropped the literal text and the second
 * one, so every page in the site shipped a title with no brand name in it. It
 * is not a visible failure, which is why it survived this long. Composing the
 * string here and passing a single expression is the reliable pattern.
 *
 * The homepage passes no title and gets the brand alone, so the tab never reads
 * as a stray fragment.
 */
const pageTitle = title ? `${title} · ${site.name}` : site.name;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {/*
      PRE-LAUNCH ONLY. The site still carries PENDING registration numbers and
      placeholder partner names, and the enquiry form does not reach an inbox
      yet, so it must not be indexed under the Career Plus name.

      This works with public/robots.txt, and neither replaces the other:
      robots.txt asks a crawler not to fetch the page, this tag tells one that
      already has it not to index it. DELETE BOTH, in the same commit, when the
      content is real and the form is wired up.
    */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={url('/logo/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/logo/favicon-32.png')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/logo/apple-touch-icon-180.png')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <nav class="actionbar" aria-label="Quick contact">
      <a href={site.contact.phoneHref}>Call</a>
      <a href={site.contact.whatsappHref}>WhatsApp</a>
      <a href="#enquire">Enquire</a>
    </nav>
  </body>
</html>
