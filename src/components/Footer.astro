---
import { url } from '../lib/url';
import { site, divisions } from '../data/site';
import { verticalsIn } from '../data/verticals';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__cols">
      {Object.values(divisions).map((d) => (
        <div>
          <h4>{d.shortName}</h4>
          <ul>
            {verticalsIn(d.id).map((v) => (
              <li><a href={url(`/${v.slug}`)}>{v.name}</a></li>
            ))}
            <li><a href={url(`/${d.id}`)}>Division overview</a></li>
          </ul>
        </div>
      ))}
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href={url('/about')}>About us</a></li>
          <li><a href={url('/contact')}>Contact</a></li>
          {/* Leaves the site: the education arm runs its own. Not a `url()` link. */}
          <li>
            <a href={site.education.href} target="_blank" rel="noopener">
              {site.education.name} &#8599;
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h4>Reach us</h4>
        <ul>
          {site.contact.phones.map((t) => (
            <li><a href={t.href}>{t.display}</a></li>
          ))}
          <li><a href={site.contact.whatsappHref}>WhatsApp {site.contact.whatsapp}</a></li>
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li>{site.contact.address}</li>
          <li>{site.contact.hours}</li>
        </ul>
      </div>
    </div>

    <div class="footer__bar">
      <span>
        {site.name} operates under {site.parent}
        {site.registrations.filter((r) => !r.pending).map((r) => ` · ${r.label} ${r.value}`)}
      </span>
      <span>© {year} {site.name}</span>
    </div>
  </div>
</footer>
