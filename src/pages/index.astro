---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { site, divisions } from '../data/site';
import { verticals, notation } from '../data/verticals';
---
<Base title="Property, finance, education and travel" description={site.positioning}>

  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{site.legacy} under {site.parent}</p>
      <h1>One group. Five ways forward.</h1>
      <p class="hero__lead">{site.positioning}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#enquire">Talk to us</a>
        <a class="btn btn--ghost" href="#services">See what we do</a>
      </div>
      <p class="hero__meta">
        Career Plus works as an advisory intermediary. Our partner banks, builders,
        universities and operators do the delivering; the group brings the judgement
        about which of them fits a given profile, and stays accountable for the
        outcome.
      </p>
    </div>
  </section>

  <section class="section" id="services" data-reveal="stagger">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we do</p>
        <h2>Five business lines, two divisions</h2>
        <p class="prose">
          Each line runs its own specialist team. The notation tells you which
          division you are entering: <strong>R</strong> for Realty &amp; Fin-Serve,
          <strong>H</strong> for Hospitality &amp; Services.
        </p>
      </div>
      <div class="grid grid--3">
        {verticals.map((v, i) => (
          <a class="card card--link" data-division={v.division} href={url(`/${v.slug}`)} style={`--i:${i}`}>
            <div class="card__head">
              <h3 style="margin:0;font-size:1.2rem">{v.name}</h3>
              <span class="notation">{notation(v)}</span>
            </div>
            <p class="card__body">{v.cardBlurb}</p>
            <span class="card__tag">{divisions[v.division].shortName}</span>
            <span class="card__more">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sand" data-reveal="stats">
    <div class="wrap">
      <div class="trust">
        {site.trustStats.map((s) => (
          <div class="trust__stat">
            <div class="trust__value" data-count>{s.value}</div>
            <div class="trust__label">{s.label}</div>
          </div>
        ))}
      </div>
      <p class="note" style="margin-top:2rem">
        Registered under {site.parent}
        {site.registrations.map((r) => ` · ${r.label} ${r.value}`)}
        <span class="pending" style="margin-left:0.5rem">Awaiting client data</span>
      </p>
    </div>
  </section>

  <section class="section section--navy" data-reveal>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How we work</p>
        <h2>The same four steps, whichever door you come through</h2>
      </div>
      <div class="steps">
        {site.howItWorks.map((s) => (
          <div class="step">
            <h4>{s.title}</h4>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Partners</p>
        <h2>We are only as good as who we work with</h2>
        <p class="prose">
          Career Plus operates on tie-ups. Every business line is backed by
          institutions that do the fulfilment.
          <span class="pending" style="margin-left:0.4rem">Logos pending</span>
        </p>
      </div>
      <div class="grid grid--3">
        {site.partners.map((p) => (
          <div class="card">
            <h4>{p.group}</h4>
            <p class="card__body">{p.names.join(' · ')}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Closing CTA. Keeps id="enquire" so the sticky action bar in Base.astro
      and the hero button still have a target on this page. */}
  <section class="section section--navy" id="enquire" data-reveal>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Get in touch</p>
        <h2>Tell us what you need</h2>
        <p class="prose">
          One conversation covers all five business lines, and we will point you
          at the team that handles yours.
        </p>
      </div>
      <div class="cta-actions">
        <a class="btn btn--primary" href={url('/contact')}>Send an enquiry</a>
        <a class="btn btn--ghost" href={site.contact.whatsappHref}>WhatsApp us</a>
      </div>
    </div>
  </section>

</Base>

<script>
  /*
   * Homepage scroll reveals. Astro bundles a page-level script only into the
   * page that declares it, so this ships on / and nowhere else.
   *
   * One observer drives every effect. It adds `.is-visible` and unobserves;
   * CSS does the section fade, the card stagger and the eyebrow hairline off
   * that one class. The only extra work here is the trust counter.
   */
  const targets = Array.from(document.querySelectorAll('[data-reveal]'));
  const showAll = () => targets.forEach((el) => el.classList.add('is-visible'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const DURATION = 600;

  function countUp(section) {
    if (reduced) return; // the real value is already in the DOM; leave it there
    section.querySelectorAll('[data-count]').forEach((node) => {
      // '25+' -> 25 and '+'. '—' has no digits and is skipped, never NaN.
      const match = /^(\d+)(.*)$/.exec(node.textContent.trim());
      if (!match) return;
      const target = Number(match[1]);
      const suffix = match[2];
      const start = performance.now();
      node.textContent = '0' + suffix;
      const tick = (now) => {
        const p = Math.min((now - start) / DURATION, 1);
        const eased = 1 - Math.pow(1 - p, 3); // ease-out, matches the CSS curve
        node.textContent = Math.round(eased * target) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }

  try {
    if (!('IntersectionObserver' in window)) {
      showAll(); // no observer: show everything rather than hide it
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target); // one-shot: never re-hides on scroll up
            if (entry.target.dataset.reveal === 'stats') countUp(entry.target);
          }
        },
        { threshold: 0, rootMargin: '0px 0px -12% 0px' }
      );
      targets.forEach((el) => io.observe(el));
    }
  } catch (err) {
    showAll();
  }
</script>
