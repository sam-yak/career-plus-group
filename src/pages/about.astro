---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { site, divisions } from '../data/site';
import { verticalsIn, notation } from '../data/verticals';
---
<Base title="About us" description={`${site.name} operates under ${site.parent}, across two divisions and five business lines.`}>
  <section class="hero">
    <div class="wrap">
      <p class="crumbs"><a href={url('/')}>Home</a><span>›</span>About</p>
      <p class="eyebrow">About</p>
      <h1>A group built on tie-ups</h1>
      <p class="hero__lead">
        {site.name} operates under {site.parent}, across five business lines and
        two divisions, on one principle: we advise honestly and hand you to the
        partners who deliver.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid--2" style="gap:3rem;align-items:start">
        <div>
          <p class="eyebrow">Our story</p>
          <h2>Why the group is structured this way</h2>
        </div>
        <div class="prose stack">
          <p>
            Career Plus grew outward from {site.parent} as families kept coming
            back with adjacent problems. Someone buying a flat needed
            a home loan. A student going abroad needed an education loan and, once
            there, somewhere to live. A hotel client needed supply.
          </p>
          <p>
            Rather than send people elsewhere, the group added the capability,
            and organised it so each line has real specialists rather than
            generalists covering everything badly.
          </p>
          <p>
            <span class="pending">Placeholder</span> Founding year, leadership
            profiles and the group's history are pending from the client and will
            replace this section before launch.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Structure</p>
        <h2>How the group is organised</h2>
      </div>
      <div class="grid grid--2">
        {Object.values(divisions).map((d) => (
          <div class="card" data-division={d.id}>
            <div class="card__head">
              <h3 style="margin:0">{d.shortName}</h3>
              <span class="notation">{d.code}</span>
            </div>
            <p class="card__body">{d.intro}</p>
            <ul class="trust__list" style="margin-top:1.2rem">
              {verticalsIn(d.id).map((v) => (
                <li><a href={url(`/${v.slug}`)}>{v.name}</a>: <span style="color:var(--ink-soft)">{v.navBlurb}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid--2" style="gap:3rem;align-items:start">
        <div>
          <p class="eyebrow">What we hold to</p>
          <h2>How we behave</h2>
        </div>
        <ul class="trust__list">
          <li>We tell you what we are: an intermediary. Our partners lend, build and operate; we know which of them to put you in front of.</li>
          <li>Fees and commissions are stated in writing before work begins.</li>
          <li>We flag the risks in a transaction, not only the upside.</li>
          <li>Your information is never passed to a partner without your consent.</li>
        </ul>
      </div>
    </div>
  </section>
</Base>
